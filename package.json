{
  "name": "@kkoms/pxtorem",
  "private": false,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/index.ts --target=browser --format=esm --outfile=dist/index.js --minify && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --minify && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run test && bun run typecheck",
    "publish-prod": "bun run prepublishOnly && npm publish --access=public"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "happy-dom": "^20.0.10",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/pxtorem.git"
  },
  "license": "MIT"
}
